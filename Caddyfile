# Auto-HTTPS. Caddy này giữ 80/443 nên nó là NƠI DUY NHẤT trên máy xin được chứng chỉ
# Let's Encrypt — ACME chỉ xác thực qua đúng hai cổng đó. Vì vậy staging KHÔNG chạy Caddy riêng
# (Caddy thứ hai ở cổng lệch sẽ không bao giờ lấy được chứng chỉ) mà đi nhờ qua đây.
#
# Một Caddy phục vụ được nhiều tên miền: nó đọc tên miền trong request rồi mới quyết đẩy đi đâu.
#
# lb_try_duration/lb_try_interval: lúc deploy tạo lại container `web` (hoặc staging đang khởi động),
# Caddy không nối được upstream. Thay vì trả 502 ngay, nó thử lại mỗi 500ms trong tối đa 20s — người
# dùng chỉ thấy request chậm một nhịp. Chỉ áp cho lỗi NỐI (request chưa tới upstream), nên không có
# nguy cơ gửi trùng một thao tác ghi. Backend khởi động lại thì nginx trong `web` tự trả 503 JSON
# kèm Retry-After (frontend/nginx.conf), phần đó do client thử lại.

# --- Production: `web` cùng project Compose nên gọi thẳng theo tên service ---
{$SITE_DOMAIN} {
	# SSE real-time luồng gửi duyệt: đẩy tức thì (flush_interval -1) + KHÔNG gzip (tránh đệm/vỡ
	# stream). handle riêng, khớp trước phần còn lại.
	@sse path /api/quotations/events*
	handle @sse {
		reverse_proxy web:80 {
			flush_interval -1
			lb_try_duration 20s
			lb_try_interval 500ms
		}
	}
	# Phần còn lại: SPA + API thường, vẫn nén gzip.
	handle {
		encode gzip
		reverse_proxy web:80 {
			lb_try_duration 20s
			lb_try_interval 500ms
		}
	}
}

# --- Staging: stack `erp-svn-stg` là project Compose KHÁC nên KHÔNG chung mạng Docker, không
# gọi được theo tên service. Đi qua cổng loopback mà `web` của nó publish — xem STG_UPSTREAM.
# STG_DOMAIN mặc định `stg.localhost` để máy dev không vỡ: Caddy cấp chứng chỉ NỘI BỘ cho tên
# `.localhost`, không gọi Let's Encrypt. Khi staging chưa dựng thì khối này chỉ trả 502, vô hại.
{$STG_DOMAIN} {
	@sse path /api/quotations/events*
	handle @sse {
		reverse_proxy {$STG_UPSTREAM} {
			flush_interval -1
			lb_try_duration 20s
			lb_try_interval 500ms
		}
	}
	handle {
		encode gzip
		reverse_proxy {$STG_UPSTREAM} {
			lb_try_duration 20s
			lb_try_interval 500ms
		}
	}
}

# --- MES Vĩnh Phát (compose project `vinhphat`, /opt/vinhphat-mes) ---
# Stack riêng, mạng Docker riêng nên KHÔNG gọi được theo tên service như khối
# production của Sao Việt. Đi qua host.docker.internal (đã khai host-gateway trong
# docker-compose.yml của erp-svn) → trỏ tới cổng mà fe/be publish trên 172.17.0.1.
vinhphat.superbai.io {
	encode gzip

	# /api/* → NestJS. Giữ NGUYÊN tiền tố /api vì BE đã setGlobalPrefix('api'),
	# tức đường dẫn thật của nó cũng bắt đầu bằng /api. Không strip gì cả.
	handle /api/* {
		reverse_proxy host.docker.internal:8101
	}

	# Còn lại → Next.js (trang, tài nguyên tĩnh, /_next/*).
	handle {
		reverse_proxy host.docker.internal:8100
	}
}